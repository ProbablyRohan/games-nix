{ pkgs, lib, config, mkPackageOption, game-pkgs, inputs, ... }:

let

  cfg = config.games-nix.falloutNV;

in {

  options.games-nix.falloutNV = {
    enable = lib.mkEnableOption "Fallout: New Vegas";
    package = mkPackageOption [ "falloutNVPackages" "falloutNV-base" ];
    NVSEx-package = mkPackageOption [ "falloutNVPackages" "NVSEx" ];
    installed-mods = lib.mkOption {
      default = game-pkgs.falloutNVPackages.installed-mods;
      description = "Mods to install";
    };
    loadorder = lib.mkOption {
      default = ''
        # This file was automatically generated by Mod Organizer.
        FalloutNV.esm
        DeadMoney.esm
        HonestHearts.esm
        OldWorldBlues.esm
        LonesomeRoad.esm
        GunRunnersArsenal.esm
        ClassicPack.esm
        MercenaryPack.esm
        TribalPack.esm
        CaravanPack.esm
        YUP - Base Game + All DLC.esm
        YUPDate.esm
        Unofficial Patch NVSE Plus.esp
        NVMIM.esp
        NVMIM - YUP Patch.esp
        fixy crap ue.esp
        Landscape Texture Improvements.esm
        Landscape Texture Improvements - YUP Patch.esm
        Landscape Disposition Fix.esm
        Landscape Disposition Fix - YUPDate Patch.esp
        Placement Fixes.esm
        Leveled DLC Delay.esm
        Bad Touch.esm
        DLC Enhancements.esp
        TLD_Travelers.esm
        The Living Desert - YUP Patch.esp
        Better Brotherhood.esm
        Goodies.esp
        Goodies - Better Brotherhood Patch.esp
        Vanilla Enhancements.esm
        EVEM - YUPDate Patch.esp
        Lone Star.esm
        Lone Star - VNV.esm
        Simple Character Expansions.esm
        Goodies - Simple Character Expansions Patch.esp
        Strip Lights Region Fix.esp
        Landscape Disposition Fix - SLRF Patch.esp
        FNV FaceGen Fix.esp
        The Mod Configuration Menu.esp
        Vanilla UI Plus.esp
        JustAssortedMods.esp
        Enhanced Movement.esp
        Enhanced Movement - Detection Fix.esp
        Better Brotherhood - YUPDate Patch.esp
        Trap Tweaks.esp
        Weathers Revised.esp
        DLC Enhancements - Weathers Revised Patch.esp
        Atmospheric Lighting Tweaks.esp
        Atmospheric Lighting Tweaks - EVEM Patch.esp
        B42Inertia.esp
        CC - Rain.esp
        CC - 3D Rain.esp
        VNV LOD Guide Plugins Merge.esp
      '';
      description = "Order to load mods, top first";
    };
    wine-package = lib.mkPackageOption pkgs "wine";
    nixGL = lib.mkOption {
      default = inputs.nixGL.packages.x86_64-linux.nixGLIntel;
      description = "nixGL package to use. Supports mesa drivers only by default";
    };
    gamescope = lib.mkPackageOption pkgs "gamescope";
    settings = lib.mkOption {
      default = game-pkgs.falloutNVPackages.FalloutPrefs-Options;
      description = "Settings to override the default settings";
    };
    installPath = lib.mkOption {
      default = ".local/share/falloutnv";
      description = "The path (relative to home dir) to install the Fallout: New Vegas data files to (must be writable)";
    };
  };

  config = let

    loadorder = pkgs.writeTextDir "loadorder.txt" cfg.loadorder;
    FalloutPrefs = pkgs.writeTextDir "FalloutPrefs.ini" ''${builtins.readFile ((pkgs.formats.ini {}).generate "FalloutPrefs.ini" cfg.settings )}'';
    falloutNV-unwrapped = pkgs.symlinkJoin {
      name = "falloutnv-unwrapped";
      paths = [
        cfg.package
        FalloutPrefs
        cfg.NVSEx
        cfg.installed-mods
      ];
    };
    falloutNV = pkgs.writeScriptBin "falloutnv" ''
      #!/usr/bin/env bash
      export WINEPREFIX=${cfg.installPath}/wine
      export WINEDLLOVERRIDES=mscoree=d

      if [ ! -d $WINEPREFIX/system.reg ]
        DISPLAY=: WAYLAND_DISPLAY="" ${cfg.wine-package}/bin/wine cmd /c dir > /dev/null 2> /dev/null
        ${cfg.wine-package}/bin/wine reg add "HKEY_LOCAL_MACHINE\Software\Wow6432Node\Bethesda Softworks\FalloutNV" /v "Installed Path" /t REG_SZ /d "Z:$(echo "${falloutNV-unwrapped}/" | sed 's~/~\\\\~g')"
        ${cfg.wine-package}/bin/wineserver -w
        "${cfg.installPath}/wine/drive_c/users/${config.user}/".source = "${cfg.installPath}/Saves";
      fi
      if [ ! "${falloutNV-unwrapped}" = "$(cat ${cfg.installPath}/game/Data/path)" ]
        cp ${falloutNV-unwrapped}/Data/*.esm ${cfg.installPath}/game/Data/
        cp ${falloutNV-unwrapped}/Data/*.esp ${cfg.installPath}/game/Data/
        for i in $(seq 1 $(sed "/^#/d" ${loadorder}/loadorder.txt | wc -l))
        do
          if [ $(date -d "1970-01-01 UTC + $i seconds" "+%Y%m%d%H%M.%s" | wc -m) -eq 15 ]
          then
            time=$(date -d "1970-01-01 UTC + $i seconds" "+%Y%m%d%H%M.0%s")
          else
            time=$(date -d "1970-01-01 UTC + $i seconds" "+%Y%m%d%H%M.%s")
          fi
          touch -camt $time "${cfg.installPath}/game/Data/$(sed "/^#/d" ${loadorder}/loadorder.txt | sed -n $(echo $i)p)"
        done
        ln -sf ${falloutNV-unwrapped}/FalloutCustom.ini "$WINEPREFIX/drive_c/users/$USER/Documents/My Games/FalloutNV/FalloutCustom.ini"
        ln -sf ${falloutNV-unwrapped}/FalloutPrefs.ini "$WINEPREFIX/drive_c/users/$USER/Documents/My Games/FalloutNV/FalloutPrefs.ini"
        echo "${falloutNV-unwrapped}" > ${cfg.installPath}/game/Data/path
      fi
      cd ${cfg.installPath}/game
      exec ${cfg.nixGL}/bin/nixGLIntel ${cfg.gamescope}/bin/gamescope -w 1920 -h 1080 -- ${cfg.wine-package}/bin/wine ${cfg.installPath}/game/FalloutNV.exe
    '';

  in lib.mkIf cfg.enable {

    packages = [ falloutNV ];
    files = {
      "${cfg.installPath}".type = "directory";
      "${cfg.installPath}/wine".type = "directory";
      "${cfg.installPath}/game".type = "directory";
      "${cfg.installPath}/Saves".type = "directory";

      "${cfg.installPath}/game/Data".type = "directory";
      "${cfg.installPath}/game/Redists".source = "${falloutNV-unwrapped}/Redists";
      "${cfg.installPath}/game/atimgpud.dll".source = "${falloutNV-unwrapped}/atimgpud.dll";
      "${cfg.installPath}/game/binkw32.dll".source = "${falloutNV-unwrapped}/binkw32.dll";
      "${cfg.installPath}/game/d3dx9_38.dll".source = "${falloutNV-unwrapped}/d3dx9_38.dll";
    };
    xdg.data.files."applications/falloutnv.desktop" = {
      generator = (pkgs.formats.ini {}).generate "falloutnv.desktop";
      value = {
        "Desktop Entry" = {
          Type = "Applications";
          Name = "Fallout: New Vegas";
          GenericName = "Game";
          Exec = "${falloutNV}/bin/falloutnv";
        };
      };
    };
  };
}
